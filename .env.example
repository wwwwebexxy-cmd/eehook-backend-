# Copy to .env for local development. Never commit the real .env file.
DEBUG=True
SECRET_KEY=generate-a-50-plus-character-random-secret-with-many-character-types
ALLOWED_HOSTS=localhost,127.0.0.1
DEPLOYMENT_ALLOWED_HOSTS=amora.nz,www.amora.nz
SITE_URL=http://localhost:5173
# Production: exact browser storefront origins only (comma separated); do not
# use * when requests include cookies.
STOREFRONT_ORIGINS=https://www.amora.nz,https://amora.nz
JWT_COOKIE_SAMESITE=Lax
TRUST_PROXY_SSL_HEADER=True

# Production only: Memcached must be reachable by every application worker.
MEMCACHED_LOCATION=127.0.0.1:11211

DB_NAME=eehook
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=127.0.0.1
DB_PORT=3306

GOOGLE_CLIENT_ID=your-google-oauth-client-id
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
